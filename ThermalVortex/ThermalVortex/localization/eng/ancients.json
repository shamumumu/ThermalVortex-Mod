  "THE_ARCHITECT.talk.THERMALVORTEX-THERMAL_VORTEX.2-1r.char": "But you answered me all the same.",
  "THE_ARCHITECT.talk.THERMALVORTEX-THERMAL_VORTEX.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.THERMALVORTEX-THERMAL_VORTEX.2-2r.ancient": "Do you take that as permission?",
