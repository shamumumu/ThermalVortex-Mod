  "THE_ARCHITECT.talk.THERMALVORTEX-THERMAL_VORTEX.2-attack": "Architect",
  "THE_ARCHITECT.talk.THERMALVORTEX-THERMAL_VORTEX.3-0r.ancient": "This Puzzle was not made by your hand.",
